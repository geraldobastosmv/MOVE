CREATE TABLE preferencias_operacionais_do_dono (
    id INT PRIMARY KEY AUTO_INCREMENT,
    local_retirada_devolucao VARCHAR(255) NOT NULL,
    disponibilidade TEXT, -- Pode incluir calendário ou períodos de blackout
    exigencias_locatario TEXT,
    regras_uso TEXT,
    entrega_retirada_realizada_por ENUM('Dono', 'MOVE', 'Parceiro') NOT NULL
);
