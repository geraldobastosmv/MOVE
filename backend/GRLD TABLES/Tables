CREATE TABLE seguro_e_responsabilidade (
    id INT PRIMARY KEY AUTO_INCREMENT,
    opcao_seguro ENUM('Apólice própria', 'Seguro MOVE') NOT NULL,
    numero_apolice VARCHAR(50),           -- Preenchido apenas se "Apólice própria"
    coberturas TEXT,                      -- Preenchido apenas se "Apólice própria"
    franquia DECIMAL(10,2),               -- Preenchido apenas se "Apólice própria"
