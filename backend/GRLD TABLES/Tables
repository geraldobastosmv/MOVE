CREATE TABLE pessoa_juridica (
    id_pj SERIAL PRIMARY KEY,
    razao_social VARCHAR(150) NOT NULL,
    cnpj CHAR(14) UNIQUE NOT NULL,
    nome_fantasia VARCHAR(150),
    endereco_fiscal TEXT NOT NULL,
    ie_im_cnae VARCHAR(100), -- campo para armazenar as três informações combinadas (IE, IM, CNAE)
    representante_legal_nome VARCHAR(150) NOT NULL,
    representante_legal_cpf CHAR(11) NOT NULL,
    representante_legal_email CITEXT NOT NULL,
    representante_legal_whatsapp VARCHAR(20),
    contrato_social TEXT, -- caminho ou URL do arquivo enviado
    aceite_pj BOOLEAN DEFAULT FALSE,
    criado_em TIMESTAMPTZ DEFAULT NOW()
);


